{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ThreatBook ATI 产品文档",
  "colors": {
    "primary": "#CC0000",
    "light": "#eb2d17",
    "dark": "#15803D"
  },
  "api": {
    "params": {
      "expanded": "all"
    },
    "playground": {
      "display": "interactive",
      "proxy": false,
      "baseUrl": "https://openapi.threatbook.cn"
    }
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "API文档",
        "groups": [
          {
            "group": "快速开始",
            "pages": [
              "api-reference/authentication"
            ]
          },
          {
            "group": "指标类威胁情报",
            "pages": [
              "api-reference/enrichment/compromise-detection-v1",
              "api-reference/enrichment/ip-intelligence-v2",
              "api-reference/enrichment/domain-intelligence-v2",
              "api-reference/enrichment/file-intelligence-v2",
              "api-reference/enrichment/file-upload-v2",
              "api-reference/enrichment/url-intelligence-v2",
              {
                "group": "已废弃",
                "pages": [
                  "api-reference/enrichment/ip-intelligence-v1",
                  "api-reference/enrichment/domain-intelligence-v1"
                ]
              }
            ]
          },
          {
            "group": "漏洞情报",
            "pages": [
              "api-reference/vulnerabilities/vulnerability-intelligence-v2"
            ]
          },
          {
            "group": "威胁态势报告",
            "pages": [
              "api-reference/reports/report-list-v3",
              "api-reference/reports/report-detail",
              {
                "group": "已废弃",
                "pages": [
                  "api-reference/reports/report-list-v2"
                ]
              }
            ]
          },
          {
            "group": "第三方集成",
            "pages": [
              "api-reference/integration/splunk-app-api"
            ]
          },
          {
            "group": "知识库",
            "pages": [
              "api-reference/threat-labels",
              "api-reference/reports-glossaries"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/logo_light.svg",
    "dark": "/logo/logo_dark.svg",
    "href": "https://ati.threatbook.cn/docs"
  },
  "navbar": {
    "links": [
      {
        "label": "登录 ATI",
