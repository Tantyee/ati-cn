{
  "openapi": "3.1.0",
  "info": {
    "title": "报告列表查询",
    "description": "查询威胁情报报告列表，支持按关键字、发布时间、报告分类、危害级别、攻击团伙、受害行业/地区等多维度进行复合筛选与分页检索。",
    "version": "1.0.0"
  },
  "tags": [],
  "paths": {
    "/v3/reports/list": {
      "post": {
        "summary": "报告列表查询",
        "deprecated": false,
        "description": "分页检索和多维筛选威胁情报报告列表（V3 接口）。",
        "tags": [],
        "parameters": [
          {
            "name": "apikey",
            "in": "query",
            "description": "您的 API Key。关于如何获取和管理 API Key，请参阅 [API 认证说明](https://ati.threatbook.cn/docs/api-reference/authentication) 页面。\n\n**温馨提示：**\n\n在发起调用前，请确认已将发起请求的服务器 IP 地址绑定至 API Key 白名单，并确认账户具备目标 API 的授权额度。",
            "required": true,
            "example": "",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "关键词搜索参数，可匹配多个已索引字段，包括报告标题、摘要、标签、IOC、CVE 标识符与名称、目标产品、目标组织及其他相关属性。"
                  },
                  "threat_type_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定用于过滤报告的一个或多个威胁事件类型。支持类型参阅 [威胁报告术语字典](https://ati.threatbook.cn/docs/api-reference/reports-glossaries)。\n\n*注意：该参数仅适用于 **Incident Analysis** 分类的报告。*"
                  },
                  "severity_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定用于过滤报告的一个或多个危害级别（如 critical、high、low）。\n\n- **critical**\n- **high**\n- **low**\n\n若未提供，则返回所有严重程度的报告。"
                  },
                  "category_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定用于筛选结果的一种或多种报告内容分类。多个值应以字符串 JSON 数组（String[]）传入。支持的分类包括：\n\n- **Incident Analysis**（事件分析）\n- **Malware Analysis**（恶意软件分析）\n- **Vulnerability Analysis**（漏洞分析）\n- **Summary Report**（总结报告）\n- **Security News**（安全资讯）\n- **Incident Response**（应急响应）"
                  },
                  "threat_actor_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定用于过滤报告的一个或多个攻击团伙/黑客组织（如 Lazarus、APT41 等）。\n\n示例值包括 **Lazarus**、**APT41** 等已知威胁组织名称。"
                  },
                  "target_region_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定用于过滤报告的一个或多个目标国家/地区。"
                  },
                  "target_region_code": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定用于筛选报告的一个或多个目标国家，使用 ISO 3166-1 alpha-2 国家代码（例如 `US`、`CN`、`GB`）。多个值应以字符串 JSON 数组（String[]）传入。完整代码列表参见 [ISO 在线浏览平台](https://www.iso.org/obp/ui/#search)。"
                  },
                  "target_industry_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定用于过滤报告的一个或多个目标行业（遵循 STIX II 行业分类）。支持行业参阅 [威胁报告术语字典](https://ati.threatbook.cn/docs/api-reference/reports-glossaries)。"
                  },
                  "target_org_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定报告中提及的一个或多个目标组织。多个值应以字符串 JSON 数组（String[]）传入。"
                  },
                  "target_product_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定报告中提及的一个或多个目标产品。多个值应以字符串 JSON 数组（String[]）传入，例如产品名称 *OpenSSH*、*Exchange Server*。"
                  },
                  "industry_of_target_org": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定用于筛选报告的一个或多个目标组织所属行业。多个值应以字符串 JSON 数组（String[]）传入。行业名称遵循 **STIX II 行业分类体系**（例如 *financial-services*、*government*、*technology* 等）。支持的行业列表参见[报告术语字典](/api-reference/reports-glossaries)。"
                  },
                  "hq_region_of_target_org": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "指定一个或多个目标组织的总部所在地区，使用 ISO 3166-1 alpha-2 国家代码（例如 `US`、`CN`、`GB`）。多个值应以字符串 JSON 数组（String[]）传入。完整代码列表参见 [ISO 在线浏览平台](https://www.iso.org/obp/ui/#search)。"
                  },
                  "has_iocs": {
                    "type": "boolean",
                    "description": "指示是否仅返回包含 IOC（失陷指标）信息的报告。 \n\n- **true**：仅返回包含 IOC 数据的报告。\n- **false** 或省略：默认包含所有报告。"
                  },
                  "has_cves": {
                    "type": "boolean",
                    "description": "指示是否仅返回包含 CVE 漏洞信息的报告。\n\n- **true**：仅返回包含 CVE 数据的报告。\n- **false** 或省略：默认包含所有报告。"
                  },
                  "has_rules": {
                    "type": "boolean",
                    "description": "指示是否仅返回包含检测规则（如 YARA、Snort）的报告。\n\n- **true**：仅返回包含检测规则数据的报告。\n- **false** 或省略：默认包含所有报告。"
                  },
                  "published_from": {
                    "type": "string",
                    "description": "指定报告发布时间范围的起始时间（含）。\n支持 ISO8601 日期时间格式，例如 `2024-09-01T00:00:00Z`。"
                  },
                  "published_to": {
                    "type": "string",
                    "description": "指定报告发布时间范围的结束时间（含）。\n支持 ISO8601 日期时间格式，例如 `2024-10-01T00:00:00Z`。"
                  },
                  "from_tb_lab": {
                    "type": "boolean",
                    "description": "指示是否仅返回微步实验室独家研发的报告。\n\n- **true**：仅返回来源于 ThreatBook Lab 的报告。\n- **false** 或省略：默认包含所有报告（包括开源情报）。"
                  },
                  "limit": {
                    "type": "integer",
                    "description": "指定每页返回的记录数。默认值为 **20**，最大允许值为 **100**。"
                  },
                  "cursor": {
                    "type": "string",
                    "description": "指定用于获取下一页结果的分页游标。如省略，则返回第一页结果。"
                  }
                }
              },
              "example": {
                "query": "",
                "limit": 100
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "cursor": {
                          "type": "string",
                          "description": "用于获取下一页结果的游标值。  \n若为空，表示没有更多数据。"
                        },
                        "total": {
                          "type": "integer",
                          "description": "符合查询筛选条件的记录总数。"
                        },
                        "limit": {
                          "type": "integer",
                          "description": "当前页返回的记录数。"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "报告的唯一标识符 ID，用于查询报告详情。"
                              },
                              "title": {
                                "type": "string",
                                "description": "威胁情报报告标题。"
                              },
                              "summary": {
                                "type": "string",
                                "description": "描述报告核心亮点的摘要信息。"
                              },
                              "source": {
                                "type": "string",
                                "description": "表示报告来源。  \n取值包括 **ThreatBook Lab**（独家内容）或 **Open Source**（开源内容）。"
                              },
                              "published_time": {
                                "type": "string",
                                "description": "报告发布时间，采用 ISO8601 格式。"
                              },
                              "event_time": {
                                "type": "string",
                                "description": "关联事件或威胁活动的发生时间。  \n根据源数据，时间粒度可能汇总至日、月或年。"
                              },
                              "severity": {
                                "type": "string",
                                "description": "报告的严重程度，例如 `low`、`high`、`critical`。"
                              },
                              "organizations": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "报告中提及的受影响组织列表。"
                              },
                              "target_orgs": {
                                "type": "array",
                                "description": "包含丰富实体属性的目标受害机构详细列表。",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "org_name": {
                                      "type": "string",
                                      "description": "目标组织名称。"
                                    },
                                    "website": {
                                      "type": "string",
                                      "description": "目标组织的官方网站域名。"
                                    },
                                    "org_industry": {
                                      "type": "array",
                                      "items": {
                                        "type": "string"
                                      },
                                      "description": "基于 STIX II 分类的受害机构所属行业列表。支持行业参阅 [威胁报告术语字典](https://ati.threatbook.cn/docs/api-reference/reports-glossaries)。"
                                    },
                                    "hq_region": {
                                      "type": "array",
                                      "items": {
                                        "type": "string"
                                      },
                                      "description": "目标组织总部所在地区或国家列表，使用 ISO 3166-1 alpha-2 国家代码（例如 `US`、`CN`、`GB`）。完整代码列表参见 [ISO 在线浏览平台](https://www.iso.org/obp/ui/#search)。"
                                    }
                                  },
                                  "required": [
                                    "org_name"
                                  ]
                                }
                              },
                              "regions": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "报告中提及的受影响地区或国家列表。"
                              },
                              "industries": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "受影响的行业列表（遵循 STIX II 行业分类）。支持行业参阅 [威胁报告术语字典](https://ati.threatbook.cn/docs/api-reference/reports-glossaries)。"
                              },
                              "products": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "报告中提及的受影响产品列表。"
                              },
                              "threat_type": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "与报告关联的一种或多种威胁事件类型。"
                              },
                              "tags": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "与报告关联的情报标签集合。目前支持的标签分类包括：\n\n- **Threat Actors**（威胁组织）\n- **Malware Families**（恶意软件家族）\n- **Attack Tools**（攻击工具）"
                              },
                              "cve_stats": {
                                "type": "integer",
                                "description": "报告中提及的 CVE 标识符总数。"
                              },
                              "reference_link": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "与报告相关的一个或多个外部来源 URL。"
                              },
                              "ioc_stats": {
                                "type": "object",
                                "properties": {
                                  "ip": {
                                    "type": "integer"
                                  },
                                  "domain": {
                                    "type": "integer"
                                  },
                                  "hash": {
                                    "type": "integer"
                                  },
                                  "url": {
                                    "type": "integer"
                                  }
                                },
                                "required": [
                                  "ip",
                                  "domain",
                                  "hash",
                                  "url"
                                ],
                                "description": "报告中 IOC 的统计信息，包括 IP、域名、哈希和 URL 的数量。"
                              }
                            },
                            "required": [
                              "id",
                              "title",
                              "summary",
                              "source",
                              "published_time",
                              "event_time",
                              "severity",
                              "organizations",
                              "target_orgs",
                              "regions",
                              "industries",
                              "products",
                              "threat_type",
                              "tags",
                              "cve_stats",
                              "reference_link",
                              "ioc_stats"
                            ]
                          }
                        }
                      },
                      "required": [
                        "cursor",
                        "total",
                        "limit",
                        "items"
                      ]
                    },
                    "response_code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string",
                      "description": "允许值：\"Success\""
                    }
                  },
                  "required": [
                    "data",
                    "response_code",
                    "msg"
                  ]
                },
                "example": {
                  "data": {
                    "cursor": "",
                    "total": 2753,
                    "limit": 100,
                    "items": [
                      {
                        "id": "303012",
                        "title": "Qilin Ransomware Targets Italian Automotive Leader Pieffe Auto Group",
                        "summary": "In 2025, the activities of the ransomware group Qilin significantly increased, launching a series of cyberattacks against enterprises and mid-sized organizations across multiple industries. Qilin employs a double extortion strategy, not only encrypting victims' data but also threatening to publicly disclose sensitive information to exert pressure, resulting in severe financial and reputational losses for businesses. The attack targets span various sectors, including automotive manufacturing, beverage production, medical devices, food industry, and legal services, demonstrating its broad attack range and increasingly sophisticated tactics. Victims include well-known companies such as Pieffe Auto Group in Italy, Asahi Group in Japan, Beta Dyne in the United States, and Volkswagen in France. Security experts recommend that affected organizations strengthen their cybersecurity defenses, including continuous monitoring, incident response plans, backup validation, and employee defense training, to mitigate the risk of future attacks. Qilin's attacks not only disrupt business operations but may also trigger a ripple effect on societal infrastructure, highlighting the urgency of cybersecurity protection.",
                        "source": "Open Source",
                        "published_time": "2025-11-25T00:00:00Z",
                        "event_time": "2025-09-17",
                        "severity": "Critical",
                        "organizations": [
                          "Volkswagen France",
                          "Echo Lake Foods, Inc."
                        ],
                        "target_orgs": [
                          {
                            "org_name": "Volkswagen France",
                            "website": "volkswagen.fr",
                            "org_industry": [
                              "Automotive",
                              "Manufacturing"
                            ],
                            "hq_region": [
                              "FR"
                            ]
                          },
                          {
                            "org_name": "Echo Lake Foods, Inc.",
                            "website": "echolakefoods.com",
                            "org_industry": [
                              "Food & Beverage",
                              "Manufacturing"
                            ],
                            "hq_region": [
                              "US"
                            ]
                          }
                        ],
                        "regions": [
                          "Netherlands",
                          "United States",
                          "Japan",
                          "UAE",
                          "Mexico",
                          "Italy",
                          "France"
                        ],
                        "industries": [
                          "Healthcare",
                          "Manufacturing",
                          "Government"
                        ],
                        "products": [],
                        "threat_type": [
                          "Ransomware"
                        ],
                        "tags": [
                          "Qilin"
                        ],
                        "cve_stats": 0,
                        "reference_link": [
                          "https://www.dexpose.io/free-darkweb-report/",
                          "https://www.dexpose.io/email-data-breach-scan/",
                          "https://cybernews.com/news/bmw-ransomware-attack-everest-claim-everest-luxury-target-jlr-trend/",
                          "https://cybernews.com/security/production-process-of-jaguar-land-rover-disrupted-by-cyberattack/",
                          "https://cybernews.com/security/jaguar-jlr-cyberattack-claimed-by-salesforce-hackers-scattered-spider-shiny-hunters/",
                          "https://cybernews.com/security/massive-salesforce-breach-campaign-started-on-github/",
                          "https://cybernews.com/news/marks-spencer-breach-tcs-third-party-vendor-social-engineering-attack/",
                          "https://cybernews.com/news/jaguar-land-rover-production-down-for-at-least-another-week-due-to-cyberattack/",
                          "https://cybernews.com/security/bridgestone-cyberattack-auto-manufacturer-disrupted-jaguar-link/",
                          "https://cybernews.com/ransomlooker/",
                          "https://cybernews.com/security/texas-electric-coops-ransomware-attack/",
                          "https://cybernews.com/news/asahi-beer-cyberattack-claimed-qilin-ransomware-stolen-data/",
                          "https://cybernews.com/news/cal-club-ransomware-attack-california-golf-club-san-franscico-qilin-claims/",
                          "https://cybernews.com/news/israel-shamir-medical-center-ransowmare-attack-qilin-8t-patient-data-stolen/",
                          "https://cybernews.com/news/nissan-ransomware-attack-creative-box-creative-box-radesign-studio-qilin-group/",
                          "https://cybernews.com/news/inotiv-ransomware-attack-qilin-pharma-research-testing-animal-cruelty-fines/",
                          "https://cybernews.com/security/singer-associates-ransomware-attack-qilin/",
                          "https://cybernews.com/news/sk-group-ransomware-attack-qilin-gang-claims-stolen-data/",
                          "https://cybernews.com/security/lee-enterprises-cyberattack-impact/",
                          "https://cybernews.com/news/houston-symphony-qilin-ransomware-attack/",
                          "https://cybernews.com/security/television-station-detroit-pbs-hacked/",
                          "https://cybernews.com/news/yanfeng-ransomware-attack-claimed-qilin/",
                          "https://cybernews.com/news/cancer-hospital-breach-is-claimed-by-qilin-gang-in-new-ransomware-low/",
                          "https://botcrawl.com/category/data-breaches/"
                        ]
                      }
                    ]
                  },
                  "response_code": 200,
                  "msg": "Success"
                }
              }
            },
            "headers": {}
          },
